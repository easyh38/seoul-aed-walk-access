POSTGRES_USER=aed
POSTGRES_PASSWORD=
POSTGRES_DB=aed
# FastAPI(api/db.py)가 읽는 DB 주소. <비밀번호>를 POSTGRES_PASSWORD와 같게 채운다
DATABASE_URL=postgresql+psycopg2://aed:<비밀번호>@localhost:5432/aed
AED_API_KEY=
# Valhalla 주소 (비우면 config.yaml의 valhalla.base_url, Docker Compose에서는 http://valhalla:8002)
VALHALLA_BASE_URL=
