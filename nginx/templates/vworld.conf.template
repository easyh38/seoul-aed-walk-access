# VWorld 배경지도 키를 .env의 VWORLD_KEY에서 받아 index.html에 끼워 넣는다.
# 공개 저장소에 키를 커밋하지 않기 위해서다 (web/index.html의 meta 값은 항상 빈 값으로 둔다).
#
# nginx 공식 이미지는 시작할 때 /etc/nginx/templates/*.template의 ${환경변수}를 채워
# /etc/nginx/conf.d/에 .conf로 저장한다 (docker-compose.yml에서 이 폴더를 마운트).
# conf.d는 http 블록에서 읽히므로 아래 설정은 모든 location의 HTML 응답(text/html)에 적용된다.
# VWORLD_KEY가 비어 있으면 빈 값 그대로 나가고, 화면은 OSM 지도를 쓴다.
sub_filter_once on;
sub_filter '<meta name="vworld-key" content="">' '<meta name="vworld-key" content="${VWORLD_KEY}">';
